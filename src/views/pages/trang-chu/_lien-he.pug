section.contact(id="lien-he" aria-labelledby="contact-title")
  .contact__container
    .contact__feature
      .contact__image
        img(src="/images/trang-chu/lien-he-01.jpg" alt="Quầy thu ngân và nhân viên chào đón tại tiệm ChipChip")
        span.contact__image-label GHÉ TIỆM CHIPCHIP
      .contact__content
        div
          .contact__eyebrow
            span HÂN HẠNH ĐÓN TIẾP
            span(aria-hidden="true") •
            span BẾP NÓNG MỖI NGÀY
          h2.contact__title(id="contact-title") Ghé ChipChip, gọi đĩa gà giòn và ngồi lại cùng nhau.
          p.contact__intro Dù là một buổi trưa nhanh gọn hay tối cuối tuần rôm rả, bếp luôn sẵn sàng phục vụ từng miếng gà nóng hổi nhất.
        .contact__actions
          .contact__hours
            span.material-symbols-outlined(aria-hidden="true") schedule
            span 09:00 - 22:30 (Cả tuần)
          a.contact__hotline(href="tel:19006868")
            span.material-symbols-outlined(aria-hidden="true") call
            span Hotline 1900 6868
    .contact__branches
      article.contact__branch
        div
          .contact__branch-head
            .contact__branch-name
              span.contact__branch-number 01
              h3 CƠ SỞ 1 • THANH XUÂN
            span.contact__city HÀ NỘI
          p.contact__detail
            span.material-symbols-outlined(aria-hidden="true") location_on
            span 128 Nguyễn Trãi, Phường Thượng Đình, Q. Thanh Xuân, Hà Nội
          p.contact__detail
            span.material-symbols-outlined(aria-hidden="true") local_parking
            span Có chỗ đậu ô tô & xe máy rộng rãi miễn phí
        .contact__branch-footer
          span.contact__service Bán mang về & Ngồi tại chỗ
          a.contact__directions(href="https://www.google.com/maps/place/Chip+Chip+Fried+CN1+%7C+%C4%82n+V%E1%BA%B7t+Ngon+Qu%E1%BA%ADn+8/@10.7413491,106.6567934,17z/data=!3m1!4b1!4m6!3m5!1s0x31752f00142433bd:0xc04c807cbb88dd51!8m2!3d10.7413438!4d106.6593737!16s%2Fg%2F11m6rn_hy0?entry=ttu&g_ep=EgoyMDI2MTAxMS4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener")
            span Chỉ đường trên Google Maps
            span.material-symbols-outlined(aria-hidden="true") arrow_outward
      article.contact__branch
        div
          .contact__branch-head
            .contact__branch-name
              span.contact__branch-number 02
              h3 CƠ SỞ 2 • HOÀN KIẾM
            span.contact__city HÀ NỘI
          p.contact__detail
            span.material-symbols-outlined(aria-hidden="true") location_on
            span 45 Hai Bà Trưng, Phường Tràng Tiền, Q. Hoàn Kiếm, Hà Nội
          p.contact__detail
            span.material-symbols-outlined(aria-hidden="true") storefront
            span Gần hồ Hoàn Kiếm, không gian 2 tầng view phố cổ
        .contact__branch-footer
          span.contact__service Bán mang về & Ngồi tại chỗ
          a.contact__directions(href="https://www.google.com/maps/place/Chip+Chip+Fried+CN2+%7C+%C4%82n+V%E1%BA%B7t+Ngon+Qu%E1%BA%ADn+8/@10.743706,106.6698419,17z/data=!3m1!4b1!4m6!3m5!1s0x31752f000ff3475d:0x7f2bac19d250d97!8m2!3d10.7437007!4d106.6724222!16s%2Fg%2F11x7t7cgv2?entry=ttu&g_ep=EgoyMDI2MTAxMS4wIKXMDSoASAFQAw%3D%3D" target="_blank" rel="noopener")
            span Chỉ đường trên Google Maps
            span.material-symbols-outlined(aria-hidden="true") arrow_outward
