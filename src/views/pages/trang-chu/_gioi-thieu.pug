section.intro(aria-labelledby="intro-title")
  .intro__container
    .intro__visuals
      .intro__main-image
        img(src="/images/trang-chu/gioi-thieu-01.jpg" alt="Mặt tiền tiệm gà ChipChip ấm cúng vào buổi tối")
      .intro__inset-image
        img(src="/images/trang-chu/gioi-thieu-02.jpg" alt="Đầu bếp ChipChip chế biến gà rán thủ công")
    .intro__content
      .intro__heading
        .intro__eyebrow
          span.intro__number 03
          span.intro__stamp(aria-hidden="true") 志
          span.intro__label GIỚI THIỆU THƯƠNG HIỆU
        h2.intro__title(id="intro-title") Tiệm gà ChipChip – Tinh hoa gà giòn thủ công, đậm đà gắn kết
      .intro__quote “Không chỉ là gà rán, đó là trải nghiệm giòn tan và niềm vui sẻ chia chân thành.”
      p.intro__lead Tiệm Gà Rán ChipChip được sinh ra từ niềm đam mê đem đến một tiêu chuẩn mới cho món gà rán quen thuộc: không công nghiệp, không tích trữ đông lạnh nhiều ngày. Chúng tôi tuyển chọn 100% thịt gà sạch tươi trong ngày từ trang trại đạt chuẩn VietGAP, ướp cùng 12 vị thảo mộc thiên nhiên trong suốt 18 tiếng.
      p.intro__copy Từng mẻ chiên kiểm soát nhiệt độ dầu chuẩn xác từng giây bằng công nghệ chiên áp suất hiện đại, giúp vỏ ngoài phồng rộp giòn tan mà bên trong vẫn giữ trọn từng thớ thịt mọng nước, đậm đà đến tận xương.
      .intro__stats
        .intro__stat
          p.intro__stat-value 100%
          p.intro__stat-label Gà tươi trong ngày
        .intro__stat
          p.intro__stat-value 18h
          p.intro__stat-label Ủ sốt thảo mộc
        .intro__stat
          p.intro__stat-value 0%
          p.intro__stat-label Dầu chiên tái chế
      a.intro__link(href="/gioi-thieu")
        span Tìm hiểu câu chuyện của bếp ChipChip
        span.material-symbols-outlined(aria-hidden="true") arrow_forward
