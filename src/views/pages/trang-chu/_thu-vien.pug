section.gallery(id="thu-vien" aria-labelledby="gallery-title")
  .gallery__container
    .gallery__heading
      div
        .gallery__eyebrow
          span.gallery__stamp(aria-hidden="true") 影
          span.gallery__label HÌNH ẢNH THỰC TẾ
        h2.gallery__title(id="gallery-title") Thư viện tiệm gà
        p.gallery__intro Món nóng, bạn bè, góc phố và những khoảnh khắc giòn tan.
      a.gallery__instagram(href="#")
        span Theo dõi Instagram @chipchip.chicken
        span.material-symbols-outlined(aria-hidden="true") open_in_new
    .gallery__grid
      figure.gallery__item.gallery__item--large
        img(src="/images/trang-chu/thu-vien-01.jpg" alt="Không gian mặt tiền tiệm gà ChipChip ở Nguyễn Trãi")
        figcaption.gallery__caption Cơ sở 1 • Nguyễn Trãi
      figure.gallery__item.gallery__item--top
        img(src="/images/trang-chu/thu-vien-02.jpg" alt="Quầy order và bếp mở của tiệm ChipChip")
        figcaption.gallery__caption Quầy Order & Bếp mở
      figure.gallery__item.gallery__item--bottom
        img(src="/images/trang-chu/thu-vien-03.jpg" alt="Nhóm bạn bè thưởng thức gà rán ChipChip")
        figcaption.gallery__caption Gắn kết bên bạn bè
      figure.gallery__item.gallery__item--wide
        img(src="/images/trang-chu/thu-vien-04.jpg" alt="Mâm tiệc nhiều món gà rán ChipChip")
        .gallery__gradient(aria-hidden="true")
        figcaption.gallery__wide-caption
          span.material-symbols-outlined(aria-hidden="true") restaurant
          span Mâm tiệc giòn tan mỗi dịp cuối tuần tại ChipChip
