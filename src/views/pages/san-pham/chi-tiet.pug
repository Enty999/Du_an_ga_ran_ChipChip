extends ../../layouts/main

block styles
  style.
    .product-detail-badge {
      background: rgba(176, 45, 33, 0.9);
      backdrop-filter: blur(4px);
    }
    .portion-card, .spicy-card {
      border: 1.5px solid #efe8df;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .portion-card:hover, .spicy-card:hover {
      border-color: #b02d21;
    }
    .portion-card.active, .spicy-card.active {
      border-color: #b02d21;
      background-color: #fff8f6;
    }
    .spicy-card.active {
      background-color: #8e130c;
      color: #fff !important;
      border-color: #8e130c;
    }
    .spicy-card.active .text-muted {
      color: rgba(255,255,255,0.8) !important;
    }
    .addon-item {
      border: 1px solid #f0e9e2;
      border-radius: 12px;
      padding: 10px 14px;
      cursor: pointer;
      transition: background 0.2s;
    }
    .addon-item:hover {
      background-color: #fff8f6;
    }
    .btn-chipchip-red {
      background-color: #8e130c;
      color: #fff;
      border: none;
      transition: all 0.2s;
    }
    .btn-chipchip-red:hover {
      background-color: #700f09;
      color: #fff;
    }

block content
  .container.py-4
    //- Breadcrumb
    nav.d-flex.justify-content-between.align-items-center.mb-4.flex-wrap.gap-2(aria-label="breadcrumb")
      ol.breadcrumb.small.mb-0
        li.breadcrumb-item
          a.text-decoration-none.text-secondary(href="/") Trang chủ
        li.breadcrumb-item
          a.text-decoration-none.text-secondary(href="/#thuc-don") Thực đơn
        li.breadcrumb-item.active.fw-semibold.text-dark(aria-current="page")= sanPham.tenSanPham
      span.badge.rounded-pill.px-3.py-2(style="background-color: #fdf3f0; color: #b02d21; font-weight: 600;")
        i.fas.fa-fire.me-1
        | Món Đậm Vị Signature Crisp

    //- ================= PHẦN 1: CHI TIẾT SẢN PHẨM & TÙY CHỌN =================
    .row.g-4.g-lg-5
      //- Cột trái: Media & Box cam kết
      .col-12.col-lg-6
        .position-relative.rounded-4.overflow-hidden.shadow-sm.mb-3(style="background-color: #fcf9f7;")
          img#main-product-img.w-100.object-fit-cover(
            src=sanPham.hinhAnh
            alt=sanPham.tenSanPham
            style="min-height: 420px; max-height: 480px;"
          )
          //- Badges trên ảnh
          .position-absolute.top-0.start-0.p-3.d-flex.flex-column.gap-2
            span.badge.product-detail-badge.text-white.px-3.py-2.rounded-pill.small
              i.fas.fa-award.me-1
              | BÁN CHẠY NHẤT #1
            span.badge.bg-dark.text-white.px-3.py-2.rounded-pill.small.bg-opacity-75
              i.fas.fa-clock.me-1
              | GỌI NHIỀU 3 GIỜ

          .position-absolute.bottom-0.start-0.end-0.p-3.d-flex.justify-content-between.align-items-center
            span.badge.bg-dark.bg-opacity-75.text-white.px-3.py-2.rounded-pill.small
              i.fas.fa-check-circle.text-success.me-1
              | 100% Gà tươi VietGAP
            span.badge.bg-white.text-dark.px-3.py-2.rounded-pill.small.shadow-sm
              | Nước sốt chuẩn vị Hàn

        //- 4 Thumbnail nhỏ
        .row.g-2.mb-4
          .col-3
            img.thumb-img.w-100.rounded-3.border.border-2.border-danger.object-fit-cover(
              src=sanPham.hinhAnh, style="height: 75px; cursor: pointer;"
            )
          .col-3
            img.thumb-img.w-100.rounded-3.border.object-fit-cover(
              src="/images/trang-chu/thuc-don-02.jpg", style="height: 75px; cursor: pointer;"
            )
          .col-3
            img.thumb-img.w-100.rounded-3.border.object-fit-cover(
              src="/images/trang-chu/thuc-don-03.jpg", style="height: 75px; cursor: pointer;"
            )
          .col-3
            img.thumb-img.w-100.rounded-3.border.object-fit-cover(
              src="/images/trang-chu/thuc-don-04.jpg", style="height: 75px; cursor: pointer;"
            )

        //- Box Cam Kết Giao Nóng 30 Phút
        .card.border-0.rounded-4.p-3(style="background-color: #fff8f6; border-left: 4px solid #b02d21 !important;")
          .d-flex.align-items-center.gap-3
            .p-3.rounded-circle.bg-white.shadow-sm.text-danger.fs-3
              i.fas.fa-shipping-fast
            .flex-grow-1
              h6.fw-bold.mb-1.text-dark Giao nóng Tới Tay 30 Phút
              p.small.text-secondary.mb-0 Hộp chuyên dụng 2 lớp giúp giữ độ giòn không hấp hơi nước.
            span.badge.bg-danger.bg-opacity-10.text-danger.p-2.rounded-3.small ĐỔI MỚI NẾU NGUỘI

      //- Cột phải: Thông tin món ăn & Bộ chọn options
      .col-12.col-lg-6
        .d-flex.justify-content-between.align-items-center.mb-2
          span.badge.bg-light.text-secondary.border.px-2.py-1.small
            | SỐ 01 / THỰC ĐƠN GÀ RÁN - CHỦ LỰC
          .small.text-muted
            i.fas.fa-star.text-warning.me-1
            strong.text-dark 4.9
            |  (520+ đánh giá)

        h1.fw-bold.text-dark.mb-1= sanPham.tenSanPham
        p.text-secondary.small.mb-3= sanPham.moTa

        //- Giá tiền & Badge giảm giá
        .d-flex.align-items-baseline.gap-3.p-3.rounded-4.mb-4(style="background-color: #fbf8f5;")
          span.fs-2.fw-bold(style="color: #b02d21;")#price-display
            = (sanPham.giaKhuyenMai || sanPham.giaGoc).toLocaleString('vi-VN') + 'đ'
          if sanPham.giaKhuyenMai && sanPham.giaKhuyenMai > 0
            span.fs-5.text-muted.text-decoration-line-through
              = sanPham.giaGoc.toLocaleString('vi-VN') + 'đ'
            span.badge.bg-danger.rounded-pill Tiết kiệm 12%

        //- 1. Chọn khẩu phần
        .mb-4
          .d-flex.justify-content-between.align-items-center.mb-2
            span.fw-bold.small 1. Chọn khẩu phần:
            span.text-muted.small Tiêu chuẩn 2 miếng (1 người dùng)
          .row.g-2
            .col-3
              .portion-card.active.text-center.p-2.rounded-3(data-price=sanPham.giaGoc)
                .fw-bold.small 2 Miếng
                .small.text-muted= (sanPham.giaKhuyenMai || sanPham.giaGoc).toLocaleString('vi-VN') + 'đ'
            .col-3
              .portion-card.text-center.p-2.rounded-3(data-price="88000")
                .fw-bold.small 4 Miếng
                .small.text-muted 88.000đ
            .col-3
              .portion-card.text-center.p-2.rounded-3(data-price="125000")
                .fw-bold.small Nửa Con
                .small.text-muted 125.000đ
            .col-3
              .portion-card.text-center.p-2.rounded-3(data-price="239000")
                .fw-bold.small Nguyên Con
                .small.text-muted 239.000đ

        //- 2. Cấp độ cay sốt
        .mb-4
          span.fw-bold.small.d-block.mb-2 2. Cấp độ cay sốt:
          .row.g-2
            .col-6
              .spicy-card.p-2.rounded-3
                .fw-semibold.small Không cay
                .text-muted(style="font-size: 11px;") Trẻ em & người không ăn cay
            .col-6
              .spicy-card.active.p-2.rounded-3
                .fw-semibold.small Cay ngọt dịu nhẹ
                .text-muted(style="font-size: 11px;") Chuẩn vị Hàn Quốc
            .col-6
              .spicy-card.p-2.rounded-3
                .fw-semibold.small Cay nồng bùng nổ
                .text-muted(style="font-size: 11px;") Vị tương ớt đỏ Hàn Quốc
            .col-6
              .spicy-card.p-2.rounded-3
                .fw-semibold.small Cay xé lưỡi cấp 3
                .text-muted(style="font-size: 11px;") Thách thức tín đồ mê cay

        //- 3. Món ăn kèm lý tưởng
        .mb-4
          span.fw-bold.small.d-block.mb-2 3. Món ăn kèm lý tưởng &amp; Tiết kiệm:
          .d-flex.flex-column.gap-2
            label.addon-item.d-flex.justify-content-between.align-items-center
              .d-flex.align-items-center.gap-2
                input.form-check-input.addon-checkbox(type="checkbox", value="10000")
                span.small Củ cải muối chua ngọt giòn sần sật
              span.badge.bg-light.text-danger +10.000đ
            label.addon-item.d-flex.justify-content-between.align-items-center
              .d-flex.align-items-center.gap-2
                input.form-check-input.addon-checkbox(type="checkbox", value="15000")
                span.small Bánh gạo tokbokki chiên lắc phô mai
              span.badge.bg-light.text-danger +15.000đ
            label.addon-item.d-flex.justify-content-between.align-items-center
              .d-flex.align-items-center.gap-2
                input.form-check-input.addon-checkbox(type="checkbox", value="25000")
                span.small Khoai tây chiên sốt phô mai
              span.badge.bg-light.text-danger +25.000đ

        //- Nút đặt hàng & Tăng giảm số lượng
        .p-3.bg-light.rounded-4.mb-3
          .d-flex.align-items-center.gap-3
            .input-group(style="width: 120px;")
              button.btn.btn-outline-secondary.btn-sm#btn-minus(type="button") -
              input.form-control.form-control-sm.text-center.fw-bold#qty-input(type="text", value="1", readonly)
              button.btn.btn-outline-secondary.btn-sm#btn-plus(type="button") +
            button.btn.btn-chipchip-red.btn-lg.fw-bold.rounded-pill.flex-grow-1(type="button")
              i.fas.fa-shopping-bag.me-2
              span#btn-cart-text  
                | Thêm vào giỏ hàng - #{ (sanPham.giaKhuyenMai || sanPham.giaGoc).toLocaleString('vi-VN') }đ

        p.text-muted.text-center(style="font-size: 11px;")
          i.fas.fa-shield-alt.me-1
          | Đổi mới nếu không hài lòng • Giao hỏa tốc 30 phút • Đóng gói hộp giữ nhiệt

    //- ================= PHẦN 2: GỢI Ý MÓN ĂN KÈM GIẢI NGẤY =================
    .mt-5.pt-4.border-top
      .d-flex.justify-content-between.align-items-end.mb-4
        div
          span.badge.bg-light.text-secondary.border.px-2.py-1.small.mb-2 03 / CHÍNH SÁCH &amp; GỢI Ý
          h3.fw-bold.text-dark.mb-0 Gợi Ý Món Ăn Kèm Giải Ngấy
        a.text-decoration-none.fw-semibold.small(href="/#thuc-don", style="color: #b02d21;")
          | Xem toàn bộ thực đơn 
          i.fas.fa-arrow-right.ms-1

      .row.g-4
        if monGoiY && monGoiY.length
          each item in monGoiY
            .col-12.col-md-4
              .card.h-100.border-0.shadow-sm.rounded-4.overflow-hidden
                .position-relative
                  img.w-100.object-fit-cover(
                    src=item.hinhAnh
                    alt=item.tenSanPham
                    style="height: 200px;"
                  )
                  span.position-absolute.top-0.start-0.m-2.badge.bg-dark.bg-opacity-75.text-white.small
                    = item.huyHieu || 'MÓN ĂN KÈM'
                .card-body.p-3.d-flex.flex-column.justify-content-between
                  div
                    .d-flex.justify-content-between.align-items-baseline.mb-1
                      h6.fw-bold.text-dark.mb-0= item.tenSanPham
                      span.fw-bold.text-danger= (item.giaKhuyenMai || item.giaGoc).toLocaleString('vi-VN') + 'đ'
                    p.text-muted.small.text-truncate= item.moTa
                  a.btn.btn-outline-dark.btn-sm.w-100.rounded-pill.mt-2.fw-semibold(href=`/san-pham/${item.slug}`)
                    | + Xem chi tiết món

block scripts
  script.
    document.addEventListener("DOMContentLoaded", () => {
      let basePrice = #{sanPham.giaKhuyenMai || sanPham.giaGoc};
      let currentPortionPrice = basePrice;
      let quantity = 1;

      const priceDisplay = document.getElementById("price-display");
      const btnCartText = document.getElementById("btn-cart-text");
      const qtyInput = document.getElementById("qty-input");

      function updateTotalPrice() {
        let addonTotal = 0;
        document.querySelectorAll(".addon-checkbox:checked").forEach(cb => {
          addonTotal += parseInt(cb.value);
        });
        const total = (currentPortionPrice + addonTotal) * quantity;
        const formatted = total.toLocaleString("vi-VN") + "đ";
        priceDisplay.textContent = formatted;
        btnCartText.textContent = `Thêm vào giỏ hàng - ${formatted}`;
      }

      // Chọn khẩu phần
      document.querySelectorAll(".portion-card").forEach(card => {
        card.addEventListener("click", () => {
          document.querySelectorAll(".portion-card").forEach(c => c.classList.remove("active"));
          card.classList.add("active");
          currentPortionPrice = parseInt(card.dataset.price);
          updateTotalPrice();
        });
      });

      // Chọn cấp độ cay
      document.querySelectorAll(".spicy-card").forEach(card => {
        card.addEventListener("click", () => {
          document.querySelectorAll(".spicy-card").forEach(c => c.classList.remove("active"));
          card.classList.add("active");
        });
      });

      // Bấm vào thumbnail nhỏ thì đổi ảnh lớn
      const mainImg = document.getElementById("main-product-img");
      const thumbs = document.querySelectorAll(".thumb-img");
      thumbs.forEach(thumb => {
        thumb.addEventListener("click", () => {
          mainImg.src = thumb.src; // Đổi ảnh lớn thành ảnh vừa bấm
          thumbs.forEach(t => t.classList.remove("border-danger", "border-2"));
          thumb.classList.add("border-danger", "border-2"); // Đổi viền đỏ sang thumbnail đang chọn
        });
      });


      // Chọn món kèm
      document.querySelectorAll(".addon-checkbox").forEach(cb => {
        cb.addEventListener("change", updateTotalPrice);
      });

      // Tăng giảm số lượng
      document.getElementById("btn-plus").addEventListener("click", () => {
        quantity++;
        qtyInput.value = quantity;
        updateTotalPrice();
      });
      document.getElementById("btn-minus").addEventListener("click", () => {
        if (quantity > 1) {
          quantity--;
          qtyInput.value = quantity;
          updateTotalPrice();
        }
      });
    });
