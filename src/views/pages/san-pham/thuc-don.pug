extends ../../layouts/main

block styles
  style.
    .menu-page-header {
      background: linear-gradient(135deg, #1f1f1f 0%, #2b1310 100%);
      padding: 50px 0 40px;
      color: #fff;
      margin-bottom: 40px;
    }
    .filter-btn-pill {
      border: 1px solid #e2d9cf;
      background: #fff;
      color: #4a4036;
      padding: 8px 20px;
      border-radius: 50rem;
      font-weight: 600;
      font-size: 14px;
      transition: all 0.2s ease;
      cursor: pointer;
    }
    .filter-btn-pill:hover, .filter-btn-pill.active {
      background-color: #b02d21;
      border-color: #b02d21;
      color: #fff;
    }
    .dish-card {
      border: 1px solid #f0eae1;
      border-radius: 16px;
      transition: all 0.25s ease;
      background: #fff;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .dish-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 24px rgba(0,0,0,0.08);
      border-color: #f3c2bc;
    }
    .dish-img-wrap {
      height: 220px;
      overflow: hidden;
      position: relative;
      background: #faf7f2;
    }
    .dish-img-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }
    .dish-card:hover .dish-img-wrap img {
      transform: scale(1.05);
    }
    .dish-badge {
      position: absolute;
      top: 12px;
      left: 12px;
      background: rgba(176, 45, 33, 0.9);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 50rem;
      letter-spacing: 0.5px;
    }

block content
  //- Phần Banner Đầu Trang
  .menu-page-header.text-center
    .container
      span.badge.rounded-pill.bg-warning.text-dark.px-3.py-2.fw-bold.mb-3 GÀ RÁN NÓNG HỔI
      h1.fw-bold.display-5.text-white Thực Đơn ChipChip
      p.text-white-50.mx-auto.mb-0(style="max-width: 600px;")
        | Từng miếng gà tươi được tẩm ướp 12 loại gia vị đặc trưng và chiên ngập dầu giòn tan theo từng lượt order.

  .container.pb-5
    //- Thanh Bộ Lọc (Tabs tự động in từ MongoDB)
    .d-flex.flex-wrap.gap-2.justify-content-center.mb-5#menu-filters
      button.filter-btn-pill.active(type="button", data-filter="all") Tất cả món
      if danhMucs && danhMucs.length > 0
        each dm in danhMucs
          button.filter-btn-pill(type="button", data-filter=dm.slug)= dm.tenDanhMuc


    //- Lưới Món Ăn (Render tự động từ MongoDB)
    .row.g-4#dishes-grid
      if sanPhams && sanPhams.length > 0
        each item in sanPhams
          .col-12.col-md-6.col-lg-4.dish-item(data-category=(item.maDanhMuc ? item.maDanhMuc.slug : ''))
            .dish-card.h-100
              .dish-img-wrap
                a(href=`/san-pham/${item.slug}`)
                  img(src=item.hinhAnh, alt=item.tenSanPham)
                if item.huyHieu
                  span.dish-badge= item.huyHieu
                else
                  span.dish-badge Món mới

              .p-4.d-flex.flex-column.flex-grow-1
                .d-flex.justify-content-between.align-items-start.mb-2
                  a.text-decoration-none.text-dark(href=`/san-pham/${item.slug}`)
                    h5.fw-bold.mb-0= item.tenSanPham
                  .text-end
                    if item.giaKhuyenMai
                      span.text-muted.text-decoration-line-through.small.d-block= item.giaGoc.toLocaleString('vi-VN') + 'đ'
                      span.fw-bold.text-danger.fs-5= item.giaKhuyenMai.toLocaleString('vi-VN') + 'đ'
                    else
                      span.fw-bold.text-danger.fs-5= item.giaGoc.toLocaleString('vi-VN') + 'đ'

                p.text-muted.small.flex-grow-1(style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;")
                  = item.moTa || 'Gà rán giòn rụm chấm kèm sốt hảo hạng, phục vụ nóng hổi.'

                .d-flex.gap-2.mt-3
                  a.btn.btn-outline-dark.rounded-pill.flex-grow-1.fw-semibold.btn-sm(href=`/san-pham/${item.slug}`)
                    | Xem chi tiết
                  a.btn.btn-danger.rounded-pill.px-3.btn-sm(href=`/san-pham/${item.slug}`)
                    i.fas.fa-shopping-bag
      else
        .col-12.text-center.py-5
          p.text-muted Hiện chưa có món ăn nào trong thực đơn.

block scripts
  script.
    document.addEventListener("DOMContentLoaded", () => {
      const filterButtons = document.querySelectorAll(".filter-btn-pill");
      const dishItems = document.querySelectorAll(".dish-item");
      filterButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          // 1. Tắt active ở tất cả các nút, chỉ bật active cho nút vừa bấm
          filterButtons.forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          // 2. Lấy mã danh mục cần lọc từ dataset (ví dụ: "ga-sot-dam-vi" hoặc "all")
          const selectedFilter = btn.dataset.filter;
          // 3. Duyệt qua từng món ăn để ẩn hoặc hiện
          dishItems.forEach(item => {
            const dishCategory = item.dataset.category;
            if (selectedFilter === "all" || dishCategory === selectedFilter) {
              item.style.display = "block"; // Hiển thị món
            } else {
              item.style.display = "none";  // Ẩn món đi
            }
          });
        });
      });
    });
