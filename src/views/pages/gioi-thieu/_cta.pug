//- Lời mời ghé thăm ChipChip
section.about-cta#ghe-chipchip
  .about-cta__container
    .about-cta__panel
      .about-cta__circle.about-cta__circle--top
      .about-cta__circle.about-cta__circle--bottom
      .about-cta__content
        .about-cta__copy
          .about-cta__eyebrow
            span.material-symbols-outlined restaurant
            span LỜI MỜI TỪ GIAN BẾP CHIPCHIP
          h2.about-cta__title Ghé ChipChip hôm nay, gọi một đĩa gà giòn và ngồi lại cùng nhau.
          p.about-cta__description Dù là một buổi trưa tất bật cần nạp năng lượng hay một buổi tối thong dong cùng những người bạn yêu quý, chúng tôi luôn có sẵn mẻ gà mới ra lò thơm nức đang chờ đón bạn.
        .about-cta__actions
          a.about-cta__button.about-cta__button--primary(href="/#thuc-don")
            span.material-symbols-outlined restaurant_menu
            span Xem Thực Đơn Ngay
          a.about-cta__button.about-cta__button--secondary(href="/#lien-he")
            span.material-symbols-outlined pin_drop
            span Tìm Cửa Hàng Gần Bạn
          .about-cta__hotline
            span.material-symbols-outlined call
            span.about-cta__hotline-label Hotline giao hàng miễn phí:
            a.about-cta__hotline-number(href="tel:19006868") 1900 6868
