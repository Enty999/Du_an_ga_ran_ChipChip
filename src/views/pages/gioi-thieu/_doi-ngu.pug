//- Section 03: Đội ngũ và những người làm bếp
section.about-team#doi-ngu
  .about-team__container
    .about-team__header
      .about-team__heading
        .about-team__chapter
          span.about-team__number 03
          span.about-team__line
          span.about-team__eyebrow NHỮNG NGƯỜI ĐỨNG BẾP
        h2.about-team__title Tâm Huyết Từ Đôi Bàn Tay Người Nấu
      p.about-team__intro Đằng sau lớp vỏ giòn rụm và mùi thơm ngất ngây là sự kiên trì, đam mê và tỉ mỉ của những con người xem nấu ăn là một nghệ thuật sẻ chia.

    .about-team__grid
      article.about-team__card
        .about-team__image-wrap
          img.about-team__image(src="/images/gioi-thieu/doi-ngu-01.jpg", alt="Chef Minh Hoàng trong gian bếp ChipChip")
          span.about-team__experience 12 NĂM KINH NGHIỆM
        .about-team__content
          .about-team__identity
            h3.about-team__name Chef Minh Hoàng
            span.about-team__role Bếp Trưởng Sáng Lập
          p.about-team__description Từng tu nghiệp ẩm thực tại Hàn Quốc và Việt Nam, Chef Hoàng dành hơn 3 năm nghiên cứu sự cân bằng nhiệt độ dầu và độ ẩm của thịt gà để tạo nên lớp vỏ giòn tan không thể trộn lẫn.
          p.about-team__quote "Gà rán ngon nhất là khi cắn vào vừa ròn rụm, vừa ứa trào dòng nước ngọt mát lành."

      article.about-team__card
        .about-team__image-wrap
          img.about-team__image(src="/images/gioi-thieu/doi-ngu-02.jpg", alt="Cô Mai Lan đang chọn và nêm gia vị")
          span.about-team__experience.about-team__experience--secondary NGHỆ NHÂN GIA VỊ
        .about-team__content
          .about-team__identity
            h3.about-team__name Cô Mai Lan
            span.about-team__role Chuyên Gia Thảo Mộc
          p.about-team__description Người thổi linh hồn vào công thức ủ thảo mộc 18 giờ. Với tình yêu nông sản quê hương, cô Lan đã tuyển chọn tỉ mỉ từng củ tỏi Lý Sơn, ớt hiểm tươi và mật ong hoa rừng Tây Bắc.
          p.about-team__quote.about-team__quote--secondary "Gia vị tự nhiên không chỉ nâng tầm vị giác mà còn vỗ về sức khỏe của thực khách."

      article.about-team__card
        .about-team__image-wrap
          img.about-team__image(src="/images/gioi-thieu/doi-ngu-03.jpg", alt="Đội ngũ phục vụ và giao vận ChipChip")
          span.about-team__experience NỤ CƯỜI CHIPCHIP
        .about-team__content
          .about-team__identity
            h3.about-team__name Đội Ngũ Phục Vụ & Giao Vận
            span.about-team__role Trái Tim Dịch Vụ
          p.about-team__description Những chàng trai, cô gái luôn giữ nụ cười rạng rỡ và sự ân cần chu đáo dù là phục vụ trực tiếp tại bàn hay phóng xe qua từng con phố để mang chiếc hộp gà nóng hổi tới tận tay bạn.
          p.about-team__quote "Tốc độ và sự cẩn trọng là lời hứa trao trọn vẹn sự thơm ngon đến bàn ăn."
