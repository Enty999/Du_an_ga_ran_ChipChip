extends ../../layouts/main

block content
  .container.py-5
    .row.justify-content-center
      .col-12.col-md-6.col-lg-5
        .card.border-0.shadow-sm.rounded-4.p-4.p-md-5(style="background: #ffffff;")
          .text-center.mb-4
            .d-inline-flex.align-items-center.justify-content-center.rounded-circle.mb-3(
              style="width: 64px; height: 64px; background-color: #ecfdf5;"
            )
              span.material-symbols-outlined.fs-1(style="color: #059669;") key
            h3.fw-bold.text-dark Đặt Lại Mật Khẩu
            p.text-muted.small Mã OTP đã được gửi đến: 
              strong.text-dark= email

          if error
            .alert.alert-danger.py-2.small.rounded-3.mb-4(role="alert")
              i.fas.fa-exclamation-circle.me-2
              = error

          form(action="/auth/dat-lai-mat-khau", method="POST")
            input(type="hidden", name="email", value=email)

            //- Mã OTP 6 số
            .mb-3
              label.form-label.fw-semibold(for="maOTP") Mã OTP (6 chữ số)
              input#maOTP.form-control.text-center.fs-5.fw-bold(
                type="text",
                name="maOTP",
                placeholder="------",
                maxlength="6",
                required,
                style="letter-spacing: 6px;"
              )

            //- Mật khẩu mới
            .mb-3
              label.form-label.fw-semibold(for="password") Mật khẩu mới
              input#password.form-control(
                type="password",
                name="password",
                placeholder="Tối thiểu 6 ký tự",
                required,
                minlength="6"
              )

            //- Nhập lại mật khẩu mới
            .mb-4
              label.form-label.fw-semibold(for="confirmPassword") Xác nhận mật khẩu mới
              input#confirmPassword.form-control(
                type="password",
                name="confirmPassword",
                placeholder="Nhập lại mật khẩu mới",
                required,
                minlength="6"
              )

            button.btn.w-100.py-2.fw-bold.text-white.rounded-pill(
              type="submit",
              style="background-color: #d97706; border-color: #d97706;"
            )
              i.fas.fa-check-circle.me-2
              | Xác nhận đổi mật khẩu

          .text-center.mt-4
            a.small.text-decoration-none(href="/auth/dang-nhap", style="color: #d97706;")
              i.fas.fa-arrow-left.me-1
              | Hủy / Quay lại Đăng nhập