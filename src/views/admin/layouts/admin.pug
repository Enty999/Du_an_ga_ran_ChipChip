doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title ? title : 'Quản trị hệ thống - Gà Rán ChipChip'}

    //- Fonts & Icons (Chuẩn phong cách BATHBOOM)
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap", rel="stylesheet")
    link(href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200", rel="stylesheet")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css")

    //- Bootstrap 5 CSS
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")

    //- CSS Quản trị Admin ChipChip
    link(rel="stylesheet", href="/css/admin/admin.css")

    block styles

  body.admin-body
    //- Sidebar trái
    include ../partials/sidebar

    //- Khu vực nội dung chính
    .admin-main
      //- Topbar
      include ../partials/topbar

      //- Container chứa nội dung các trang con
      main.admin-container
        block content

    //- Chart.js (Chuẩn BATHBOOM cho biểu đồ thống kê)
    script(src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js")
    //- SweetAlert2
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    //- Bootstrap 5 JS Bundle
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    //- JS Admin
    script(src="/js/admin/admin.js")

    block scripts
