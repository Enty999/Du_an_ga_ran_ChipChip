extends ../../layouts/admin

block content
  //- ========================================================
  //- 1. THANH TIÊU ĐỀ (CHUẨN BATHBOOM)
  //- ========================================================
  .mgmt-topbar
    .mgmt-title-group
      h1.mgmt-title
        i.fa-solid.fa-utensils(style="color: #C98F91;")
        | Thêm món ăn mới vào thực đơn
      .stats-badge-group
        span.stat-pill.stat-pill-total
          i.fa-solid.fa-plus
          | Tạo mới sản phẩm

    div(style="display: flex; gap: 8px;")
      a.btn-filter-reset(href="/admin/san-pham")
        i.fa-solid.fa-arrow-left
        span Quay lại danh sách

  //- ========================================================
  //- 2. FORM THÊM MỚI (CHUẨN FORM BATHBOOM)
  //- ========================================================
  form(action="/admin/san-pham/them-moi", method="POST")
    .row.g-4
      //- Cột trái: Thông tin món ăn
      .col-12.col-lg-8
        .bb-card
          .p-3.d-flex.align-items-center.gap-2(style="background: #FCFAF8; border-bottom: 2px solid #8D7B6F;")
            i.fa-solid.fa-circle-info(style="color: #C98F91; font-size: 16px;")
            h3(style="font-family: 'Playfair Display', serif; font-size: 16.5px; margin: 0; color: #4A3E3D; font-weight: 700;")
              | Thông tin chi tiết món ăn
          .p-4
            .row.g-3
              .col-12.col-md-7
                label.form-label-custom
                  | Tên món ăn 
                  span.required *
                input.form-control-custom(
                  type="text",
                  name="tenSanPham",
                  placeholder="Ví dụ: Gà Giòn Cay Sốt Seoul",
                  required
                )

              .col-12.col-md-5
                label.form-label-custom Tên tiếng Anh (phụ)
                input.form-control-custom(
                  type="text",
                  name="tenTiengAnh",
                  placeholder="Ví dụ: Seoul Spicy Crispy Chicken"
                )

              .col-12.col-md-6
                label.form-label-custom
                  | Danh mục món 
                  span.required *
                select.form-control-custom(name="maDanhMuc", required)
                  option(value="") -- Chọn danh mục --
                  each dm in danhMucList
                    option(value=dm._id)= dm.tenDanhMuc

              .col-12.col-md-6
                label.form-label-custom Khẩu phần hiển thị
                input.form-control-custom(
                  type="text",
                  name="khauPhan",
                  placeholder="Ví dụ: 2 miếng, 1 phần...",
                  value="1 phần"
                )

              .col-12.col-md-6
                label.form-label-custom
                  | Giá gốc (VNĐ) 
                  span.required *
                input.form-control-custom(
                  type="number",
                  name="giaGoc",
                  placeholder="Ví dụ: 45000",
                  min="0",
                  required
                )

              .col-12.col-md-6
                label.form-label-custom Giá khuyến mãi (nếu có)
                input.form-control-custom(
                  type="number",
                  name="giaKhuyenMai",
                  placeholder="Ví dụ: 39000",
                  min="0"
                )

              .col-12
                label.form-label-custom Mô tả hương vị &amp; nguyên liệu
                textarea.form-control-custom(
                  name="moTa",
                  rows="4",
                  placeholder="Mô tả độ giòn tan, nước sốt đặc trưng hoặc thành phần..."
                )

      //- Cột phải: Hình ảnh & Thuộc tính
      .col-12.col-lg-4
        .bb-card
          .p-3.d-flex.align-items-center.gap-2(style="background: #FCFAF8; border-bottom: 2px solid #8D7B6F;")
            i.fa-solid.fa-image(style="color: #8E9F8E; font-size: 16px;")
            h3(style="font-family: 'Playfair Display', serif; font-size: 16.5px; margin: 0; color: #4A3E3D; font-weight: 700;")
              | Hình ảnh &amp; Trạng thái
          .p-4
            .d-flex.flex-column.align-items-center.gap-2.mb-3
              .image-preview-wrapper(style="width: 100px; height: 100px; border-radius: 12px; border: 2px solid #DCD4CC;")
                img#img-preview(
                  src="/images/trang-chu/thuc-don-01.jpg",
                  alt="Xem trước ảnh",
                  style="width: 100%; height: 100%; object-fit: cover;"
                )
              small.text-muted(style="font-size: 11px;") Xem trước hiển thị trên Menu

            .mb-3
              label.form-label-custom Đường dẫn ảnh (URL)
              input#input-hinh-anh.form-control-custom(
                type="text",
                name="hinhAnh",
                placeholder="/images/trang-chu/thuc-don-01.jpg",
                value="/images/trang-chu/thuc-don-01.jpg"
              )

            .mb-3
              label.form-label-custom Số lượng tồn kho ban đầu
              input.form-control-custom(
                type="number",
                name="soLuongTon",
                value="100",
                min="0"
              )

            .mb-3
              label.form-label-custom Huy hiệu nổi bật (Badge)
              input.form-control-custom(
                type="text",
                name="huyHieu",
                placeholder="Bán chạy, Mới, Hot..."
              )

            .mb-3
              label.form-label-custom Trạng thái bán
              select.form-control-custom(name="trangThai")
                option(value="dang-ban") 🟢 Đang bán
                option(value="het-hang") 🟠 Hết hàng
                option(value="ngung-ban") 🔴 Ngừng bán

            .form-check.mb-4
              input.form-check-input#noiBat(type="checkbox", name="noiBat", value="true")
              label.form-check-label(for="noiBat", style="font-size: 13px; font-weight: 600; color: #4A3E3D;")
                | Ghim lên danh sách món NỔI BẬT

            .form-actions-custom(style="margin-top: 10px; padding-top: 14px;")
              button.btn-submit-custom.w-100(type="submit")
                i.fa-solid.fa-plus
                span Tạo món mới
