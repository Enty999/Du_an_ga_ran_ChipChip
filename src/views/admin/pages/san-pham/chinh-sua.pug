extends ../../layouts/admin

block content
  //- ========================================================
  //- 1. THANH TIÊU ĐỀ (CHUẨN BATHBOOM)
  //- ========================================================
  .mgmt-topbar
    .mgmt-title-group
      h1.mgmt-title
        i.fa-solid.fa-pen-to-square(style="color: #C98F91;")
        | Chỉnh sửa món: #{monAn.tenSanPham}
      .stats-badge-group
        span.stat-pill.stat-pill-total
          i.fa-solid.fa-barcode
          | #{monAn.slug}

    div(style="display: flex; gap: 8px;")
      a.btn-filter-reset(href="/admin/san-pham")
        i.fa-solid.fa-arrow-left
        span Quay lại danh sách

  //- ========================================================
  //- 2. FORM CHỈNH SỬA (CHUẨN FORM BATHBOOM)
  //- ========================================================
  form(action=`/admin/san-pham/chinh-sua/${monAn._id}`, method="POST")
    .row.g-4
      //- Cột trái: Thông tin món ăn
      .col-12.col-lg-8
        .bb-card
          .p-3.d-flex.align-items-center.gap-2(style="background: #FCFAF8; border-bottom: 2px solid #8D7B6F;")
            i.fa-solid.fa-circle-info(style="color: #C98F91; font-size: 16px;")
            h3(style="font-family: 'Playfair Display', serif; font-size: 16.5px; margin: 0; color: #4A3E3D; font-weight: 700;")
              | Cập nhật thông tin chi tiết
          .p-4
            .row.g-3
              .col-12.col-md-7
                label.form-label-custom
                  | Tên món ăn 
                  span.required *
                input.form-control-custom(
                  type="text",
                  name="tenSanPham",
                  value=monAn.tenSanPham,
                  required
                )

              .col-12.col-md-5
                label.form-label-custom Tên tiếng Anh (phụ)
                input.form-control-custom(
                  type="text",
                  name="tenTiengAnh",
                  value=monAn.tenTiengAnh || ''
                )

              .col-12.col-md-6
                label.form-label-custom Đường dẫn tĩnh (Slug)
                input.form-control-custom(
                  type="text",
                  name="slug",
                  value=monAn.slug
                )
                small.text-muted(style="font-size: 11px;") Để trống nếu muốn tự động tạo lại theo tên món.

              .col-12.col-md-6
                label.form-label-custom
                  | Danh mục món 
                  span.required *
                select.form-control-custom(name="maDanhMuc", required)
                  each dm in danhMucList
                    - const isSelected = monAn.maDanhMuc && (monAn.maDanhMuc._id ? monAn.maDanhMuc._id.toString() : monAn.maDanhMuc.toString()) === dm._id.toString()
                    option(value=dm._id, selected=isSelected)= dm.tenDanhMuc

              .col-12.col-md-6
                label.form-label-custom Khẩu phần hiển thị
                input.form-control-custom(
                  type="text",
                  name="khauPhan",
                  value=monAn.khauPhan || '1 phần'
                )

              .col-12.col-md-6
                label.form-label-custom
                  | Giá gốc (VNĐ) 
                  span.required *
                input.form-control-custom(
                  type="number",
                  name="giaGoc",
                  value=monAn.giaGoc,
                  min="0",
                  required
                )

              .col-12.col-md-6
                label.form-label-custom Giá khuyến mãi (nếu có)
                input.form-control-custom(
                  type="number",
                  name="giaKhuyenMai",
                  value=monAn.giaKhuyenMai || '',
                  min="0"
                )

              .col-12
                label.form-label-custom Mô tả hương vị &amp; nguyên liệu
                textarea.form-control-custom(
                  name="moTa",
                  rows="4"
                )= monAn.moTa

      //- Cột phải: Hình ảnh & Thuộc tính
      .col-12.col-lg-4
        .bb-card
          .p-3.d-flex.align-items-center.gap-2(style="background: #FCFAF8; border-bottom: 2px solid #8D7B6F;")
            i.fa-solid.fa-image(style="color: #8E9F8E; font-size: 16px;")
            h3(style="font-family: 'Playfair Display', serif; font-size: 16.5px; margin: 0; color: #4A3E3D; font-weight: 700;")
              | Hình ảnh &amp; Trạng thái
          .p-4
            .d-flex.flex-column.align-items-center.gap-2.mb-3
              .image-preview-wrapper(style="width: 100px; height: 100px; border-radius: 12px; border: 2px solid #DCD4CC;")
                img#img-preview(
                  src=monAn.hinhAnh,
                  alt="Xem trước ảnh",
                  onerror="this.src='/images/trang-chu/thuc-don-01.jpg'",
                  style="width: 100%; height: 100%; object-fit: cover;"
                )
              small.text-muted(style="font-size: 11px;") Xem trước hiển thị trên Menu

            .mb-3
              label.form-label-custom Đường dẫn ảnh (URL)
              input#input-hinh-anh.form-control-custom(
                type="text",
                name="hinhAnh",
                value=monAn.hinhAnh
              )

            .mb-3
              label.form-label-custom Số lượng tồn kho
              input.form-control-custom(
                type="number",
                name="soLuongTon",
                value=monAn.soLuongTon,
                min="0"
              )

            .mb-3
              label.form-label-custom Huy hiệu nổi bật (Badge)
              input.form-control-custom(
                type="text",
                name="huyHieu",
                value=monAn.huyHieu || ''
              )

            .mb-3
              label.form-label-custom Trạng thái bán
              select.form-control-custom(name="trangThai")
                option(value="dang-ban", selected=monAn.trangThai === 'dang-ban') 🟢 Đang bán
                option(value="het-hang", selected=monAn.trangThai === 'het-hang') 🟠 Hết hàng
                option(value="ngung-ban", selected=monAn.trangThai === 'ngung-ban') 🔴 Ngừng bán

            .form-check.mb-4
              input.form-check-input#noiBat(type="checkbox", name="noiBat", value="true", checked=monAn.noiBat)
              label.form-check-label(for="noiBat", style="font-size: 13px; font-weight: 600; color: #4A3E3D;")
                | Ghim lên danh sách món NỔI BẬT

            .form-actions-custom(style="margin-top: 10px; padding-top: 14px;")
              button.btn-submit-custom.w-100(type="submit")
                i.fa-solid.fa-floppy-disk
                span Lưu thay đổi
