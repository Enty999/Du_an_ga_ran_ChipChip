doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{title ? title + ' - Gà Rán ChipChip' : 'Gà Rán ChipChip'}
    
    //- Font chữ đẹp Google Fonts
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap", rel="stylesheet")
    
    //- 1. Bootstrap 5 CSS CDN
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css", rel="stylesheet")
    
    //- 2. CSS dùng chung toàn dự án
    link(rel="stylesheet", href="/css/style.css")
    
    //- 3. Khối để từng trang nhúng CSS riêng (nếu có)
    block styles

  body
    include ../partials/header

    main.main-content
      block content

    include ../partials/footer

    //- 4. Bootstrap 5 JS Bundle CDN
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    
    //- 5. Khối để từng trang nhúng JS riêng (nếu có)
    block scripts
