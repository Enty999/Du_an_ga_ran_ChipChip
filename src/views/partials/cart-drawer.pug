//- src/views/partials/cart-drawer.pug
#cartOffcanvas.offcanvas.offcanvas-end(tabindex="-1", aria-labelledby="cartOffcanvasLabel", style="width: 440px; max-width: 95vw;")
  .offcanvas-header.border-bottom.px-4.py-3(style="background-color: #fff9f8;")
    .d-flex.align-items-center.gap-2
      span.material-symbols-outlined.text-danger(style="font-size: 28px;") shopping_bag
      h5#cartOffcanvasLabel.offcanvas-title.fw-bold.mb-0 Giỏ hàng ChipChip
      span.badge.rounded-pill.bg-danger#drawer-cart-count 0 món
    button.btn-close(type="button", data-bs-dismiss="offcanvas", aria-label="Close")

  .offcanvas-body.p-4.d-flex.flex-column
    //- Khi giỏ hàng trống
    #cart-empty-view.text-center.my-auto.py-5(style="display: none;")
      .mb-3
        i.fas.fa-drumstick-bite.fa-4x.text-muted.opacity-50
      h6.fw-bold.text-dark Giỏ hàng của bạn đang đói!
      p.text-muted.small.mb-4 Hãy chọn những món gà rán giòn rụm nóng hổi ngay nhé.
      a.btn.btn-danger.rounded-pill.px-4.py-2.fw-semibold(href="/thuc-don", data-bs-dismiss="offcanvas")
        i.fas.fa-utensils.me-2
        | Khám phá thực đơn

    //- Khi giỏ hàng có món: render danh sách
    #cart-items-view.flex-grow-1.overflow-y-auto.pe-1
      #cart-items-list.d-flex.flex-column.gap-3

  //- Footer giỏ hàng: Tạm tính & Nút Đặt hàng
  .offcanvas-footer.border-top.p-4.bg-white#cart-footer-view
    .d-flex.justify-content-between.align-items-center.mb-2
      span.text-muted Tạm tính:
      span.fw-bold.fs-5.text-danger#cart-total-price 0đ
    p.text-muted.small.mb-3
      i.fas.fa-info-circle.me-1
      | Phí vận chuyển sẽ được tính tại bước thanh toán.
    .d-grid.gap-2
      a.btn.btn-danger.btn-lg.rounded-pill.fw-bold.shadow-sm#btn-checkout(href="/thanh-toan")
        | Tiến hành thanh toán
        i.fas.fa-arrow-right.ms-2
      button.btn.btn-outline-secondary.rounded-pill.btn-sm(type="button", data-bs-dismiss="offcanvas") Tiếp tục chọn món
    //- Toast thông báo thêm giỏ hàng dùng chung toàn website (Góc dưới bên phải)
.toast-container.position-fixed.bottom-0.end-0.p-3(style="z-index: 1100;")
  #cart-toast.toast.align-items-center.text-white.border-0.rounded-4.shadow-lg(
    role="alert"
    aria-live="assertive"
    aria-atomic="true"
    style="background: linear-gradient(135deg, #1f1f1f 0%, #2b1310 100%);"
  )
    .d-flex
      .toast-body.d-flex.align-items-center.gap-3.py-3
        .rounded-circle.p-2.d-flex.align-items-center.justify-content-center(style="background-color: #b02d21; width: 40px; height: 40px;")
          i.fas.fa-check.text-white.fs-6
        div
          h6.fw-bold.mb-0.text-white Đã thêm vào giỏ hàng!
          small.text-white-50#toast-message Thêm món thành công
      button.btn-close.btn-close-white.me-2.m-auto(type="button", data-bs-dismiss="toast", aria-label="Close")